PROJECT_NAME             = "Sattyre"
PROJECT_NUMBER           = "@PROJECT_VERSION@"
PROJECT_BRIEF            = "Modular SAT/SMT framework"
OUTPUT_DIRECTORY         = @CMAKE_BINARY_DIR@/docs
CREATE_SUBDIRS           = NO
OUTPUT_LANGUAGE          = English

INPUT                    = @PROJECT_SOURCE_DIR@/include \
                           @PROJECT_SOURCE_DIR@/src \
                           @PROJECT_SOURCE_DIR@/docs
FILE_PATTERNS            = *.h *.hpp *.c *.cpp *.rst *.md
RECURSIVE                = YES
EXCLUDE_PATTERNS         = */third_party/*

OPTIMIZE_OUTPUT_FOR_C    = YES
EXTRACT_ALL              = YES
QUIET                    = YES
WARN_IF_DOC_ERROR        = YES
WARN_IF_UNDOCUMENTED     = NO

MARKDOWN_SUPPORT         = YES
AUTOLINK_SUPPORT         = YES
EXTENSION_MAPPING        = rst=md
USE_MDFILE_AS_MAINPAGE   = @PROJECT_SOURCE_DIR@/docs/FrontPage.rst

GENERATE_HTML            = YES
HTML_OUTPUT              = html

GENERATE_LATEX           = YES
LATEX_OUTPUT             = latex
USE_PDFLATEX             = NO
LATEX_CMD_NAME           = xelatex
LATEX_BATCHMODE          = YES

GENERATE_DOCBOOK         = YES
DOCBOOK_OUTPUT           = docbook

GENERATE_XML             = YES
XML_OUTPUT               = xml
XML_PROGRAMLISTING       = YES
